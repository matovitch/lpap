# pixi environments
.pixi/*
!.pixi/config.toml

# Python and tool caches
__pycache__/
*.py[cod]
.ruff_cache/

# marimo local session state
notebooks/__marimo__/

# large local datasets and generated archives
data/*.tar
data/*.tar.*
data/*.pt

# local model checkpoints
checkpoints/*.pt

# local training logs
training_logs/*.sqlite
training_logs/*.sqlite-*

# Secrets: configs/secrets.toml only (never commit). Legacy .hf_token ignored.
.hf_token
.env
configs/secrets.toml

# Local reboot archives (checkpoints/logs)
archive/

# Manim render outputs (mp4/png/partial movie files)
animations/media/
media/
animations/__pycache__/

# Tectonic / TeX build intermediates (keep committed PNG in doc/assets/)
doc/tex/build/
