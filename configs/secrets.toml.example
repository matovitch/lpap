# Local secrets for molab injection (copy to configs/secrets.toml and fill in).
# configs/secrets.toml is gitignored — never commit real values.
#
# Inject into a paired molab kernel:
#   bash .github/skills/molab-workflow/scripts/molab-inject-secrets.sh
#
# Sets kernel env (no values printed). Also writes /marimo/.hf_token when
# [huggingface].token is set, so artifact_sync token_files keep working.

[huggingface]
# Write token (HF Storage Bucket uploads). Same value as a local .hf_token file.
token = ""

[pushover]
# Application API token from https://pushover.net (create an "Application").
token = ""
# User key from the Pushover dashboard.
user = ""
# When both are set, molab-inject-secrets.sh also sets LPAP_NOTIFY_ON_FINISHED=1
# so TrainingRun.mark_finished sends a Pushover ping (unless disabled).
