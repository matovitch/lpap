# Local secrets for molab / local tooling (copy to configs/secrets.toml and fill).
# configs/secrets.toml is gitignored — never commit real values.
#
# Inject into a paired molab kernel (env only; no secret files under /marimo):
#   bash .github/skills/molab-workflow/scripts/molab-inject-secrets.sh
#
# Re-run after every kernel restart. Pass the same env into detached workers.

[huggingface]
# Write token (HF Storage Bucket uploads) → HF_TOKEN
token = ""

[pushover]
# Application API token from https://pushover.net (create an "Application").
token = ""
# User key from the Pushover dashboard.
user = ""
# When both are set, inject also sets LPAP_NOTIFY_ON_FINISHED=1.
